    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "mysql-memory-server": "^1.16.0",
    "supertest": "^7.3.0"
  }
}
