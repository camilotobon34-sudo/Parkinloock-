{
  "name": "backend-parkinlock",
  "version": "1.0.0",
  "description": "API REST de PARKINLOCK: gestión de parqueadero (Node.js + Express + MySQL 8)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
