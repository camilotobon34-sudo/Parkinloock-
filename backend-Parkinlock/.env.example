# Copie este archivo como .env y complete los valores. No suba el archivo .env a Git.

# Base de datos MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parkinlock_db
DB_USER=parkinlock_app
DB_PASSWORD=cambie_esta_contrasena

# Clave para firmar los JWT (mínimo 32 caracteres aleatorios).
# Puede generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplace_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Puerto del API
PORT=3000

# Opcionales
# JWT_EXPIRES_IN=8h
# CORS_ORIGIN=http://localhost:5173
# APP_TZ=America/Bogota
