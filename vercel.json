{
  "framework": "vite",
  "installCommand": "npm install --prefix frontend-Parkinlock- && npm install --prefix backend-Parkinlock",
  "buildCommand": "npm run build --prefix frontend-Parkinlock-",
  "outputDirectory": "frontend-Parkinlock-/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
