{
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix ../backend-Parkinlock",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
